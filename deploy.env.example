# Copy to .env.deploy (git-ignored) and fill in. Never commit real values or secrets.
# From `npx wrangler d1 create cql-onboarding-production`:
D1_DATABASE_ID=
D1_NAME=cql-onboarding-production
R2_BUCKET=cql-onboarding-private
WORKER_NAME=cql-onboarding
# Hostname only, e.g. onboarding.corequantumleads.com
CUSTOM_DOMAIN=
# Zero Trust > Settings > Custom Pages / team domain, e.g. myteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Zero Trust > Access > Applications > your app > Application Audience (AUD) tag
CF_ACCESS_AUD=
# Comma-separated owner/admin emails
OWNER_EMAILS=
