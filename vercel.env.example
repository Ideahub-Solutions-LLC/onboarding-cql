# Set these in Vercel > Project > Settings > Environment Variables (Production). Never commit real values.
# Turso database (https://turso.tech): `turso db create cql-onboarding`, then `turso db show --url` and `turso db tokens create cql-onboarding`
DATABASE_URL=libsql://YOUR-DATABASE.turso.io
DATABASE_AUTH_TOKEN=
# Random secret for sign-in links and sessions: openssl rand -base64 48
AUTH_SECRET=
# Encrypts domain passwords: openssl rand -base64 32 (back it up; rotating it makes stored credentials unreadable)
VAULT_KEY=
OWNER_EMAILS=chito@ideahubsolutionsinc.com,ludwig@marketingmediacloud.com,alvin@marketingmediacloud.com
# Email delivery for sign-in links (https://resend.com). Verify your sending domain first.
RESEND_API_KEY=
MAIL_FROM=CQL Launchpad <onboarding@corequantumleads.com>
